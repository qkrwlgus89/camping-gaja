# Supabase project > Connect. Public key only in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; legacy SUPABASE_SERVICE_ROLE_KEY also supported.
SUPABASE_SECRET_KEY=
# data.go.kr > 기상청 단기예보 조회서비스 > Decoding key (server only).
KMA_SERVICE_KEY=
# Local two-session verification only. Rejected on Vercel.
ENABLE_LOCAL_DEMO=false
# Optional: expose scene/time/weather fixtures on a private preview. Disable for release.
NEXT_PUBLIC_ENABLE_SCENE_LAB=false
